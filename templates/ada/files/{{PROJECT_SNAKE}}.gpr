with "aunit";

--  Objects and executables go to /cache so the project tree stays clean and a
--  second build reuses the first one's work. See docs/containers.md.
project {{PROJECT_SNAKE}} is

   for Source_Dirs use ("src", "tests");
   for Object_Dir use "/cache/build/obj";
   for Exec_Dir use "/cache/build/bin";

end {{PROJECT_SNAKE}};
